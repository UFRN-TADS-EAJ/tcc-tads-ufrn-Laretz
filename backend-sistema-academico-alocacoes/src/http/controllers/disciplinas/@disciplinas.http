}

###

# @name UpdateDisciplina
PUT {{baseURL}}/disciplinas/43357332-f437-4344-b8fc-3fcdeca85f81
Content-Type: application/json

{
  "nome": "Algoritmos e Estruturas de Dados Avançados",
  "codigo": "AED002",
  "carga_horaria": 100,
  "semestre": 4,
  "data_fim_real": "2024-06-28T18:00:00.000Z"
}

###

# @name DeleteDisciplina
DELETE {{baseURL}}/disciplinas/43357332-f437-4344-b8fc-3fcdeca85f81
Content-Type: application/json

