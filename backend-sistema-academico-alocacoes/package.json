{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "build": "tsup src/server.ts --out-dir build",
    "seed": "tsx src/scripts/popular-banco-completo.ts",
    "test": "npm run test:unit",
    "test:unit": "npx prisma generate && vitest run --project unit --config vitest.config.mts",
    "test:unit:watch": "vitest --project unit --config vitest.config.mts",
    "test:e2e": "npx prisma generate && vitest run --project e2e --config vitest.config.mts",
    "test:e2e:watch": "vitest --project e2e --config vitest.config.mts",
    "test:all": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "test:coverage:unit": "vitest run --coverage --project unit --config vitest.config.mts",
    "test:coverage:e2e": "vitest run --coverage --project e2e --config vitest.config.mts",
    "test:ui": "npx prisma generate && vitest --ui --config vitest.config.mts --api.host=127.0.0.1 --api.port=3001",
    "setup:horarios": "tsx src/scripts/criar-horarios.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@rocketseat/eslint-config": "2.2.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^24.3.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "prisma": "6.14.0",
    "supertest": "7.1.4",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.20.5",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/jwt": "10.0.0",
    "@fastify/swagger": "9.5.2",
    "@fastify/swagger-ui": "5.2.3",
    "@prisma/client": "6.14.0",
    "bcryptjs": "3.0.2",
    "dotenv": "17.2.1",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "6.0.0",
    "tsup": "^8.5.0",
    "zod": "4.1.12"
  }
}
