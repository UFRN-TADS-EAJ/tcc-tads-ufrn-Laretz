{
  "compilerOptions": {
    /* Entrada e saída */
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Ambiente e módulo */
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "types": ["node", "vitest/globals"],

    /* Mapas e tipagem */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Regras mais seguras */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Recomendações úteis */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Garante compatibilidade ESM/Node */
    "allowSyntheticDefaultImports": true,
    "moduleDetection": "force"
  },

  /* Inclui todos os arquivos relevantes */
  "include": ["src/**/*.ts", "prisma/**/*.ts", "vitest.config.ts"],

  /* Exclui arquivos que não precisam de build */
  "exclude": ["node_modules", "dist", "build", "**/*.http"]
}
